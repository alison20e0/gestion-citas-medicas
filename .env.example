# Copia este archivo a .env y ajusta los valores si lo necesitas.
# .env esta en .gitignore, no se versiona.
DB_NAME=citas_db
DB_USER=admin
DB_PASSWORD=secretpassword123

# Puertos publicados en el host (contenedores)
DB_PORT_PUBLISHED=5443
APP_PORT=8083

TZ=America/Guayaquil
CITA_ZONA_HORARIA=America/Guayaquil

# Recordatorios de cita
NOTIFICACIONES_HABILITADAS=true
NOTIFICACIONES_SIMULAR_FALLO=false
NOTIFICACIONES_HORAS_ANTICIPACION=24
NOTIFICACIONES_MAX_INTENTOS=4
NOTIFICACIONES_ESPERA_REINTENTO=30s
NOTIFICACIONES_INTERVALO_BARRIDO_MS=60000
NOTIFICACIONES_LATENCIA=120ms